# =====================================================================
# Civic Sentinel — SERVER environment variables (Vercel → Settings →
# Environment Variables). These are secret and must NEVER be committed
# or placed in config.js / any front-end file.
# =====================================================================

# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # secret! full DB access

# From Cloudflare → Turnstile → your site → Settings
TURNSTILE_SECRET_KEY=YOUR-TURNSTILE-SECRET-KEY    # secret (pairs with the public site key)

# Optional: any random string. Salts the hashed IP used for rate limiting so
# stored hashes can't be reversed. Defaults to a constant if unset.
RATE_SALT=change-me-to-any-random-string

# Note: the PUBLIC values (SUPABASE_URL, SUPABASE_ANON_KEY, TURNSTILE_SITEKEY)
# also go into /config.js so the browser can read them. Only the two *secret*
# keys above are server-only.
